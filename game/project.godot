[rendering]

renderer/rendering_method="forward_plus"
; SPEC.txt Section 13 does not specify an MSAA level; 2x MSAA applied as an engine-default baseline per plan Step 3, flagged for later tuning, not a SPEC number.
anti_aliasing/quality/msaa_3d=1
