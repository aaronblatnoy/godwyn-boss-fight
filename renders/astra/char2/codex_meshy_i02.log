   162	def planar_cut_and_cap(ob, cut_z):
   163	    bm = bmesh.new()
   164	    bm.from_mesh(ob.data)
   165	    bm.verts.ensure_lookup_table()
   166	    result = bmesh.ops.bisect_plane(
   167	        bm,
   168	        geom=list(bm.verts) + list(bm.edges) + list(bm.faces),
   169	        dist=1.0e-7,
   170	        plane_co=(0.0, 0.0, float(cut_z)),
   171	        plane_no=(0.0, 0.0, 1.0),
   172	        use_snap_center=False,
   173	        clear_inner=True,
   174	        clear_outer=False,
   175	    )
   176	    cut_edges = [x for x in result.get("geom_cut", []) if isinstance(x, bmesh.types.BMEdge)]
   177	    boundary = [edge for edge in cut_edges if edge.is_valid and len(edge.link_faces) == 1]
   178	    filled = []
   179	    if boundary:
   180	        fill = bmesh.ops.holes_fill(bm, edges=boundary, sides=0)
   181	        filled = [face for face in fill.get("faces", []) if face.is_valid]
   182	        for face in filled:
   183	            face.smooth = True
   184	    bm.to_mesh(ob.data)
   185	    bm.free()
   186	    ob.data.update()
   187	    skin_attr = ob.data.color_attributes.get("meshy_skin_mask")
   188	    hair_attr = ob.data.color_attributes.get("meshy_hair_mask")
   189	    for poly in ob.data.polygons:
   190	        if all(abs(float(ob.data.vertices[vi].co.z) - cut_z) <= 2.5e-6 for vi in poly.vertices):
   191	            for li in poly.loop_indices:
   192	                if skin_attr:
   193	                    skin_attr.data[li].color = (1.0, 1.0, 1.0, 1.0)
   194	                if hair_attr:
   195	                    hair_attr.data[li].color = (0.0, 0.0, 0.0, 1.0)
   196	    cut_vertices = [v.index for v in ob.data.vertices if abs(float(v.co.z) - cut_z) <= 2.5e-6]
   197	    return {
   198	        "bisect_cut_edges": len(cut_edges),
   199	        "boundary_edges_before_fill": len(boundary),
   200	        "cap_faces_created": len(filled),
   201	        "cut_plane_vertices": len(cut_vertices),
   202	    }
