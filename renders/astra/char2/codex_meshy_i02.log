   260	def face_hair_flags(ob):
   261	    attr = ob.data.color_attributes.get("meshy_hair_mask")
   262	    if not attr:
   263	        raise RuntimeError("Native candidate lacks meshy_hair_mask")
   264	    flags = []
   265	    for poly in ob.data.polygons:
   266	        mean = np.mean([attr.data[li].color[0] for li in poly.loop_indices])
   267	        flags.append(bool(mean >= 0.5))
   268	    return flags
