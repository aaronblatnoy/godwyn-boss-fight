   336	def make_neck_band(arm, cut_z):
   337	    rows, sides = 9, 64
   338	    verts, faces = [], []
   339	    for row in range(rows):
   340	        t = row / (rows - 1)
   341	        z = NECK_BASE_Z + (cut_z - NECK_BASE_Z) * t
   342	        rx = 0.090 + 0.005 * t
   343	        ry = 0.070 + 0.008 * t
   344	        cy = -0.235 - 0.008 * t
   345	        for side in range(sides):
   346	            angle = math.tau * side / sides
   347	            verts.append((rx * math.cos(angle), cy + ry * math.sin(angle), z))
   348	    for row in range(rows - 1):
   349	        for side in range(sides):
   350	            a = row * sides + side
   351	            b = row * sides + (side + 1) % sides
   352	            faces.append((a, b, b + sides, a + sides))
   353	    mesh = bpy.data.meshes.new("AstraChar2 Meshy i02 neck blend mesh")
   354	    mesh.from_pydata(verts, [], faces)
   355	    mesh.materials.append(make_neck_material())
   356	    for poly in mesh.polygons:
   357	        poly.use_smooth = True
   358	    ob = bpy.data.objects.new("AstraChar2_Meshy_NeckBlend", mesh)
   359	    bpy.context.scene.collection.objects.link(ob)
   360	    ob.parent = arm
   361	    ob.matrix_parent_inverse = arm.matrix_world.inverted()
   362	    for group in bpy.data.objects["char1"].vertex_groups:
   363	        ob.vertex_groups.new(name=group.name)
   364	    blend_start = cut_z - 0.040
   365	    for vertex in mesh.vertices:
   366	        if vertex.co.z >= blend_start:
   367	            t = min(1.0, max(0.0, (vertex.co.z - blend_start) / max(cut_z - blend_start, 1.0e-8)))
   368	            ob.vertex_groups["neck"].add([vertex.index], 1.0 - t, "REPLACE")
   369	            ob.vertex_groups["Head"].add([vertex.index], t, "REPLACE")
   370	        else:
   371	            t = max(0.0, min(1.0, (vertex.co.z - 2.64) / 0.08))
   372	            ob.vertex_groups["Spine"].add([vertex.index], 1.0 - t, "REPLACE")
   373	            ob.vertex_groups["neck"].add([vertex.index], t, "REPLACE")
   374	    modifier = ob.modifiers.new("Existing 121-bone skin", "ARMATURE")
   375	    modifier.object = arm
   376	    return ob
