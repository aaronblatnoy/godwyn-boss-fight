hook: PostToolUse Completed
codex
The first audit exposed a real issue, so I’m not accepting that build: the chosen 40 mm-below-rim plane fell into a topology gap and created zero cut edges/cap faces. I’m moving the bisect to the supplied hidden collar-base datum z = 2.605 m (143.500 mm below the measured rim), retaining the proven neck blend through z = 2.735 m, and adding hard assertions that the plane actually intersects, produces a boundary, and creates caps. This directly prevents a “pass” that merely deletes lower components while leaving a jagged open edge.
apply patch
patch: completed
/Users/aaron_7nh0yzm/godwyn-boss-fight/scripts/astra_meshy_i02_build.py
diff --git a/scripts/astra_meshy_i02_build.py b/scripts/astra_meshy_i02_build.py
index b9627d910be60005785ed802c830df1799d31a37..b6d0e96b2571e49b338b2f576c73272b59903b51
--- a/scripts/astra_meshy_i02_build.py
+++ b/scripts/astra_meshy_i02_build.py
@@ -23,7 +23,7 @@
 OFFSET = np.array((0.00043, -0.25190, 2.85520), dtype=float)
 EYE_PIVOT = np.array((0.00043, -0.37956585, 2.97655010), dtype=float)
 NECK_BASE_Z = 2.605
-RIM_CLEARANCE_M = 0.040
+NECK_BLEND_TOP_Z = 2.735
 FLOATING_FRAGMENT_MAX_M = 0.015
 SECTORS = 24
 
@@ -338,7 +338,7 @@
     verts, faces = [], []
     for row in range(rows):
         t = row / (rows - 1)
-        z = NECK_BASE_Z + (cut_z - NECK_BASE_Z) * t
+        z = cut_z + (NECK_BLEND_TOP_Z - cut_z) * t
         rx = 0.090 + 0.005 * t
         ry = 0.070 + 0.008 * t
         cy = -0.235 - 0.008 * t
@@ -361,10 +361,10 @@
     ob.matrix_parent_inverse = arm.matrix_world.inverted()
     for group in bpy.data.objects["char1"].vertex_groups:
         ob.vertex_groups.new(name=group.name)
-    blend_start = cut_z - 0.040
+    blend_start = NECK_BLEND_TOP_Z - 0.040
     for vertex in mesh.vertices:
         if vertex.co.z >= blend_start:
-            t = min(1.0, max(0.0, (vertex.co.z - blend_start) / max(cut_z - blend_start, 1.0e-8)))
+            t = min(1.0, max(0.0, (vertex.co.z - blend_start) / max(NECK_BLEND_TOP_Z - blend_start, 1.0e-8)))
             ob.vertex_groups["neck"].add([vertex.index], 1.0 - t, "REPLACE")
             ob.vertex_groups["Head"].add([vertex.index], t, "REPLACE")
         else:
@@ -506,7 +506,12 @@
     rests = {bone.name: np.array(bone.matrix_local) for bone in arm.data.bones}
     assert len(arm.data.bones) == 121 and len(bpy.data.actions) == 0
     rim = measure_rim()
-    cut_z = float(rim["visible_upper_rim_z_m"] - RIM_CLEARANCE_M)
+    # The supplied hidden collar-base datum is safely below the visible rim and
+    # crosses the original Meshy bust.  Using the nearer rim-minus-40mm plane
+    # lands in a gap between the source's disconnected patches, which cannot
+    # yield a real planar cut/cap and would preserve the jagged boundary.
+    cut_z = float(NECK_BASE_Z)
+    assert rim["visible_upper_rim_z_m"] - cut_z >= 0.025
 
     remove_prefixes = (
         "AstraChar2_Mpfb_Head", "AstraChar2_Eyeball_", "AstraChar2_Iris_", "AstraChar2_Pupil_",
@@ -568,6 +573,10 @@
     hair = split_hair(ob, hair_faces)
     hair_bounds_before = [world_points(hair).min(axis=0).tolist(), world_points(hair).max(axis=0).tolist()]
     cut_stats = planar_cut_and_cap(ob, cut_z)
+    assert cut_stats["bisect_cut_edges"] > 0, "Planar bisect did not intersect the non-hair Meshy region"
+    assert cut_stats["boundary_edges_before_fill"] > 0, "Planar bisect produced no boundary to cap"
+    assert cut_stats["cap_faces_created"] > 0, "Planar cut boundary was not capped"
+    assert cut_stats["cut_plane_vertices"] > 0, "Planar cut produced no vertices on the requested plane"
     floating_records = remove_floating_hair_fragments(hair, cut_z)
     hair_bounds_after = [world_points(hair).min(axis=0).tolist(), world_points(hair).max(axis=0).tolist()]
     classification["hair_bounds_before_fragment_cleanup_m"] = hair_bounds_before
@@ -602,7 +611,7 @@
             "masked_mix": {"node": "Meshy i02 skin mix", "blend_type": "MIX", "factor_source": "meshy_skin_mask"},
         },
     }
-    audit["binding"] = {"meshy": "rigid Head 1.0", "neck_blend": "Spine/neck/Head", "neck_band_z_range_m": [NECK_BASE_Z, cut_z]}
+    audit["binding"] = {"meshy": "rigid Head 1.0", "neck_blend": "Spine/neck/Head", "neck_band_z_range_m": [cut_z, NECK_BLEND_TOP_Z]}
     audit["bones"] = len(arm.data.bones)
     audit["actions"] = len(bpy.data.actions)
     audit["rest_matrix_error"] = rest_error

