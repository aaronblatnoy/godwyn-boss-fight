   119	            before = rest[ob.name]
   120	            edge_ids = edges[ob.name]
   121	            assert len(after) == len(before)
   122	            assert np.isfinite(after).all() and float(np.max(np.abs(after))) < 10.0
   123	            before_lengths = np.linalg.norm(before[edge_ids[:, 0]] - before[edge_ids[:, 1]], axis=1)
   124	            after_lengths = np.linalg.norm(after[edge_ids[:, 0]] - after[edge_ids[:, 1]], axis=1)
   125	            usable = before_lengths > 0.0003
   126	            ratios = after_lengths[usable] / before_lengths[usable]
   127	            result[label][ob.name] = {
   128	                "edge_count_tested": int(usable.sum()),
   129	                "edge_stretch_max": float(ratios.max()),
   130	                "edge_stretch_p99": float(np.quantile(ratios, 0.99)),
   131	            }
   132	            assert float(ratios.max()) < 2.0
   133	            print("MESHY_I02_STRESS", label, ob.name, float(ratios.max()), flush=True)
   134	    reset(arm)
   135	    result["neutral_restored"] = all(np.allclose(np.array(bone.matrix_basis), np.eye(4), atol=1.0e-6) for bone in arm.pose.bones)
   136	    assert result["neutral_restored"]
   137	    return result
