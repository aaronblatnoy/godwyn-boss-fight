   181	def export_glb():
   182	    bpy.ops.wm.open_mainfile(filepath=str(CANDIDATE))
   183	    arm = bpy.data.objects["Armature"]
   184	    reset(arm)
   185	    bpy.ops.object.select_all(action="DESELECT")
   186	    selected = []
   187	    for ob in bpy.context.scene.objects:
   188	        asset = ob.name.startswith("AstraChar2_") or ob.name in {"char1", "Astra_Undersleeves", "Godwyn_Sword"}
   189	        include = ob == arm or (asset and ob.type == "MESH" and len(ob.data.polygons) and not ob.hide_render)
   190	        if include:
   191	            ob.hide_set(False)
   192	            ob.hide_render = False
   193	            ob.select_set(True)
   194	            selected.append(ob.name)
   195	    bpy.context.view_layer.objects.active = arm
   196	    options = dict(filepath=str(GLB), export_format="GLB", use_selection=True,
   197	                   export_animations=False, export_skins=True, export_def_bones=False,
   198	                   export_leaf_bone=False, export_apply=True, export_texcoords=True,
   199	                   export_normals=True, export_materials="EXPORT", export_all_influences=False,
   200	                   export_cameras=False, export_lights=False)
   201	    valid = bpy.ops.export_scene.gltf.get_rna_type().properties.keys()
   202	    options = {key: value for key, value in options.items() if key in valid}
   203	    bpy.ops.export_scene.gltf(**options)
   204	    assert GLB.exists() and GLB.stat().st_size > 0
   205	    print("MESHY_I02_EXPORT_PASS", GLB.stat().st_size, sha256(GLB), flush=True)
