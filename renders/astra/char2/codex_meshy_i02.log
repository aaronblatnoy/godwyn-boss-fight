+    links.new(source.outputs["Color"], bsdf.inputs["Base Color"])
+    for name in ("Meshy i02 SPEC multiply", "Meshy i02 warm HSV", "Meshy i02 skin mask", "Meshy i02 skin mix"):
+        node = nodes.get(name)
+        if node:
+            nodes.remove(node)
+
+
