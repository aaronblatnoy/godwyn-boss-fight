   215	def roundtrip_validation():
   216	    bpy.ops.wm.read_factory_settings(use_empty=True)
   217	    bpy.ops.import_scene.gltf(filepath=str(GLB))
   218	    arm = next(ob for ob in bpy.data.objects if ob.type == "ARMATURE")
   219	    reset(arm)
   220	    baseline = json.loads(BASELINE.read_text())["bones"]
   221	    errors = {
   222	        bone.name: float(np.max(np.abs(np.array(arm.matrix_world @ bone.head_local) - np.array(baseline[bone.name]["head"]))))
   223	        for bone in arm.data.bones
   224	    }
   225	    gltf = glb_json(GLB)
   226	    report = {
   227	        "source": str(GLB.relative_to(ROOT)),
   228	        "source_bytes": GLB.stat().st_size,
   229	        "source_sha256": sha256(GLB),
   230	        "bones": len(arm.data.bones),
   231	        "actions": len(bpy.data.actions),
   232	        "world_joint_position_max_error_m": max(errors.values()),
   233	        "world_joint_position_tolerance_m": 0.00005,
   234	        "bone_names_and_hierarchy_preserved": all(
   235	            (bone.parent.name if bone.parent else None) == baseline[bone.name]["parent"] for bone in arm.data.bones
   236	        ),
   237	        "glb_skin_joint_counts": [len(skin["joints"]) for skin in gltf.get("skins", [])],
   238	        "glb_animations": len(gltf.get("animations", [])),
   239	        "numeric_only": True,
   240	        "render_calls": 0,
   241	    }
   242	    assert report["bones"] == 121 and report["actions"] == 0
   243	    assert report["world_joint_position_max_error_m"] < report["world_joint_position_tolerance_m"]
   244	    assert report["bone_names_and_hierarchy_preserved"]
   245	    assert report["glb_skin_joint_counts"] and all(count == 121 for count in report["glb_skin_joint_counts"])
   246	    assert report["glb_animations"] == 0
   247	    report["weights"] = weight_check([ob for ob in bpy.context.scene.objects if not ob.hide_render], arm)
   248	    assert report["weights"]["unweighted_or_bad_sum_vertices"] == 0
   249	    report["poses"] = stress_metrics(arm)
   250	    ROUNDTRIP.write_text(json.dumps(report, indent=2) + "\n")
   251	    print("MESHY_I02_ROUNDTRIP_PASS", json.dumps({"bones": report["bones"],
   252	          "joint_error_m": report["world_joint_position_max_error_m"], "unweighted": report["weights"]["unweighted_or_bad_sum_vertices"]}), flush=True)
