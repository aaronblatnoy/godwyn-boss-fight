   502	def main():
   503	    bpy.ops.wm.open_mainfile(filepath=str(BASE))
   504	    arm = bpy.data.objects["Armature"]
   505	    reset_pose(arm)
   506	    rests = {bone.name: np.array(bone.matrix_local) for bone in arm.data.bones}
   507	    assert len(arm.data.bones) == 121 and len(bpy.data.actions) == 0
   508	    rim = measure_rim()
   509	    cut_z = float(rim["visible_upper_rim_z_m"] - RIM_CLEARANCE_M)
   510	
   511	    remove_prefixes = (
   512	        "AstraChar2_Mpfb_Head", "AstraChar2_Eyeball_", "AstraChar2_Iris_", "AstraChar2_Pupil_",
   513	        "AstraChar2_Cornea_", "AstraChar2_Wetline_", "AstraChar2_TearCorner_", "AstraChar2_Eyebrows_",
   514	        "AstraChar2_Lashes_", "AstraChar2_Nostril_", "AstraChar2_R5_Curves_MPFB_",
   515	        "AstraChar2_R5_Control_MPFB_", "AstraChar2_R5_Strands_MPFB_", "AstraChar2_R4_",
   516	        "AstraChar2_R2_Hair", "AstraChar2_R3_Flow_", "AstraChar2_R3_Plait_",
   517	    )
   518	    for ob in list(bpy.data.objects):
   519	        if ob.name.startswith(remove_prefixes):
   520	            bpy.data.objects.remove(ob, do_unlink=True)
   521	
   522	    before = set(bpy.data.objects)
   523	    bpy.ops.import_scene.gltf(filepath=str(MESHY))
   524	    imported = [ob for ob in bpy.data.objects if ob not in before and ob.type == "MESH"]
   525	    assert len(imported) == 1
   526	    ob = imported[0]
   527	    ob.scale = (SCALE,) * 3
   528	    ob.location = OFFSET
   529	    bpy.context.view_layer.objects.active = ob
   530	    ob.select_set(True)
   531	    bpy.ops.object.transform_apply(location=False, rotation=False, scale=True)
   532	    for vertex in ob.data.vertices:
   533	        q = np.array(vertex.co, dtype=float)
   534	        q[:2] = EYE_PIVOT[:2] + FIT_XY * (q[:2] - EYE_PIVOT[:2])
   535	        vertex.co = q
   536	    ob.data.update()
   537	    # Bake translation only after reproducing i01's fit, preserving identical
   538	    # world placement while making the planar cut and audits use world meters.
   539	    bpy.ops.object.transform_apply(location=True, rotation=False, scale=False)
   540	
   541	    mat = ob.data.materials[0]
   542	    _, base_image, pixels, width, height = base_color_pixels(mat)
   543	    rgb = face_rgb(ob, pixels, width, height)
   544	    hair_faces, skin_faces, lumas, raw_centers = classify_faces(ob, rgb)
   545	    add_face_masks(ob, hair_faces, skin_faces)
   546	    classification = {
   547	        "method": "per-face mean base-color texel plus raw-source geometry; hair requires warm/dark texels outside face/neck core",
   548	        "hair_thresholds": {
   549	            "luma_weights": [0.2126, 0.7152, 0.0722],
   550	            "ordinary_luma_max": HAIR_LUMA_MAX,
   551	            "strong_luma_max": HAIR_STRONG_LUMA_MAX,
   552	            "r_minus_b_min": HAIR_R_MINUS_B_MIN,
   553	            "g_minus_b_min": HAIR_G_MINUS_B_MIN,
   554	            "face_core_raw": {"abs_x_lt": 0.305, "y_lt": -0.205, "z_gt": -0.18, "z_lt": 0.54},
   555	            "neck_core_raw": {"abs_x_lt": 0.235, "y_lt": 0.10, "z_gt": -0.60, "z_lte": -0.18},
   556	            "hair_geometry_raw": "z>0.54 OR |x|>0.305 OR y>-0.080 OR (z<-0.18 AND (|x|>0.205 OR y>0.015))",
   557	        },
   558	        "skin_thresholds": {"luma_min": 0.43, "r_minus_b_min": 0.105, "not_hair_required": True},
   559	        "source_faces": len(ob.data.polygons),
   560	        "hair_faces": int(hair_faces.sum()),
   561	        "skin_faces": int(skin_faces.sum()),
   562	        "other_skin_or_garment_faces": int(len(hair_faces) - hair_faces.sum() - skin_faces.sum()),
   563	        "hair_luma_quantiles": np.quantile(lumas[hair_faces], [0.05, 0.5, 0.95]).tolist(),
   564	        "skin_luma_quantiles": np.quantile(lumas[skin_faces], [0.05, 0.5, 0.95]).tolist(),
   565	        "mask_attributes": {"hair": "meshy_hair_mask", "skin": "meshy_skin_mask"},
   566	    }
   567	
   568	    hair = split_hair(ob, hair_faces)
   569	    hair_bounds_before = [world_points(hair).min(axis=0).tolist(), world_points(hair).max(axis=0).tolist()]
   570	    cut_stats = planar_cut_and_cap(ob, cut_z)
   571	    floating_records = remove_floating_hair_fragments(hair, cut_z)
   572	    hair_bounds_after = [world_points(hair).min(axis=0).tolist(), world_points(hair).max(axis=0).tolist()]
   573	    classification["hair_bounds_before_fragment_cleanup_m"] = hair_bounds_before
   574	    classification["hair_bounds_after_fragment_cleanup_m"] = hair_bounds_after
