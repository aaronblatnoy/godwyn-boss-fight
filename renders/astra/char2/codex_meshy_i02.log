   205	def connected_components(ob):
   206	    count = len(ob.data.vertices)
   207	    parent = np.arange(count, dtype=np.int32)
   208	
   209	    def find(value):
   210	        while parent[value] != value:
   211	            parent[value] = parent[parent[value]]
   212	            value = int(parent[value])
   213	        return value
   214	
   215	    def union(a, b):
   216	        a, b = find(int(a)), find(int(b))
   217	        if a != b:
   218	            parent[b] = a
   219	
   220	    for edge in ob.data.edges:
   221	        union(*edge.vertices)
   222	    roots = np.array([find(i) for i in range(count)], dtype=np.int32)
   223	    return roots
