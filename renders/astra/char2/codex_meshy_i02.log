   226	def remove_floating_hair_fragments(ob, cut_z):
   227	    roots = connected_components(ob)
   228	    points = np.array([v.co[:] for v in ob.data.vertices], dtype=float)
   229	    kill_roots = set()
   230	    records = []
   231	    for root in np.unique(roots):
   232	        ids = np.where(roots == root)[0]
   233	        q = points[ids]
   234	        size = np.ptp(q, axis=0)
   235	        if float(q[:, 2].max()) < cut_z and float(size.max()) < FLOATING_FRAGMENT_MAX_M:
   236	            kill_roots.add(int(root))
   237	            records.append({
   238	                "vertices": int(len(ids)),
   239	                "min_world_m": q.min(axis=0).tolist(),
   240	                "max_world_m": q.max(axis=0).tolist(),
   241	                "max_dimension_m": float(size.max()),
   242	            })
   243	    if kill_roots:
   244	        bm = bmesh.new()
   245	        bm.from_mesh(ob.data)
   246	        bm.verts.ensure_lookup_table()
   247	        doomed = [v for v in bm.verts if int(roots[v.index]) in kill_roots]
   248	        bmesh.ops.delete(bm, geom=doomed, context="VERTS")
   249	        bm.to_mesh(ob.data)
   250	        bm.free()
   251	        ob.data.update()
   252	    return records
