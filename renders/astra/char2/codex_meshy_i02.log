   379	def measure_rim():
   380	    rim = bpy.data.objects["AstraChar2_R5_GorgetRim"]
   381	    points = world_points(rim)
   382	    rim_z = float(points[:, 2].max())
   383	    center = np.array(((points[:, 0].min() + points[:, 0].max()) * 0.5,
   384	                       (points[:, 1].min() + points[:, 1].max()) * 0.5), dtype=float)
   385	    top = points[points[:, 2] >= rim_z - 0.004]
   386	    radii = np.linalg.norm(top[:, :2] - center[None, :], axis=1)
   387	    inner_radius = float(np.quantile(radii, 0.10))
   388	    sector_inner = []
   389	    angles = np.mod(np.arctan2(top[:, 1] - center[1], top[:, 0] - center[0]), math.tau)
   390	    for sector in range(SECTORS):
   391	        mask = (angles >= math.tau * sector / SECTORS) & (angles < math.tau * (sector + 1) / SECTORS)
   392	        sector_inner.append(float(radii[mask].min()) if mask.any() else None)
   393	    return {
   394	        "object": rim.name,
   395	        "visible_upper_rim_z_m": rim_z,
   396	        "xy_center_m": center.tolist(),
   397	        "inner_radius_global_p10_m": inner_radius,
   398	        "inner_radius_by_sector_m": sector_inner,
   399	        "top_band_definition_m": 0.004,
   400	    }
   401	
   402	
   403	def gorget_shards():
   404	    report = {"definition": "disconnected component with <=12 triangles and maximum bbox dimension <30 mm", "objects": [], "count": 0, "locations": []}
   405	    for name in ("AstraChar2_R5_Gorget", "AstraChar2_R5_GorgetRim"):
   406	        ob = bpy.data.objects[name]
   407	        roots = connected_components(ob)
   408	        points = world_points(ob)
   409	        face_roots = {}
   410	        for poly in ob.data.polygons:
   411	            root = int(roots[poly.vertices[0]])
   412	            face_roots.setdefault(root, 0)
   413	            face_roots[root] += max(1, len(poly.vertices) - 2)
   414	        object_row = {"name": name, "component_count": int(len(np.unique(roots))), "shard_count": 0}
   415	        for root in np.unique(roots):
   416	            ids = np.where(roots == root)[0]
   417	            q = points[ids]
   418	            size = np.ptp(q, axis=0)
   419	            triangles = int(face_roots.get(int(root), 0))
   420	            if triangles <= 12 and float(size.max()) < 0.030:
   421	                row = {"object": name, "triangles": triangles, "vertices": int(len(ids)),
   422	                       "centroid_world_m": q.mean(axis=0).tolist(), "bbox_min_world_m": q.min(axis=0).tolist(),
   423	                       "bbox_max_world_m": q.max(axis=0).tolist(), "bbox_size_m": size.tolist()}
   424	                report["locations"].append(row)
   425	                report["count"] += 1
   426	                object_row["shard_count"] += 1
   427	        report["objects"].append(object_row)
   428	    return report
