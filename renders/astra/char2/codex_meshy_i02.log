   431	def audit_cut(ob, rim, cut_z, cut_stats, floating_records, classification):
   432	    points = np.array([v.co[:] for v in ob.data.vertices], dtype=float)
   433	    skin_attr = ob.data.color_attributes.get("meshy_skin_mask")
   434	    hair_attr = ob.data.color_attributes.get("meshy_hair_mask")
   435	    vertex_skin = np.zeros(len(ob.data.vertices), dtype=float)
   436	    vertex_hair = np.zeros(len(ob.data.vertices), dtype=float)
   437	    counts = np.zeros(len(ob.data.vertices), dtype=float)
   438	    for poly in ob.data.polygons:
   439	        for li in poly.loop_indices:
   440	            vi = ob.data.loops[li].vertex_index
   441	            vertex_skin[vi] += float(skin_attr.data[li].color[0])
   442	            vertex_hair[vi] += float(hair_attr.data[li].color[0])
   443	            counts[vi] += 1.0
   444	    vertex_skin /= np.maximum(counts, 1.0)
   445	    vertex_hair /= np.maximum(counts, 1.0)
   446	    center = np.array(rim["xy_center_m"], dtype=float)
   447	    radial = np.linalg.norm(points[:, :2] - center[None, :], axis=1)
   448	    angles = np.mod(np.arctan2(points[:, 1] - center[1], points[:, 0] - center[0]), math.tau)
   449	    on_cut = (np.abs(points[:, 2] - cut_z) <= 2.5e-6) & (vertex_skin >= 0.5)
   450	    rows = []
   451	    outside_above_rim = 0
   452	    for sector in range(SECTORS):
   453	        angular = (angles >= math.tau * sector / SECTORS) & (angles < math.tau * (sector + 1) / SECTORS)
   454	        mask = on_cut & angular
   455	        sector_radius = rim["inner_radius_by_sector_m"][sector]
   456	        if sector_radius is None:
   457	            sector_radius = rim["inner_radius_global_p10_m"]
   458	        outside = mask & (radial > sector_radius)
   459	        outside_max_z = float(points[outside, 2].max()) if outside.any() else None
   460	        sector_violations = int(np.sum(outside & (points[:, 2] > rim["visible_upper_rim_z_m"] + 1.0e-7)))
   461	        outside_above_rim += sector_violations
   462	        max_z = float(points[mask, 2].max()) if mask.any() else None
   463	        rows.append({
   464	            "sector": sector,
   465	            "angle_start_deg": 360.0 * sector / SECTORS,
   466	            "angle_end_deg": 360.0 * (sector + 1) / SECTORS,
   467	            "skin_cut_vertices": int(mask.sum()),
   468	            "max_skin_cut_z_m": max_z,
   469	            "rim_z_m": rim["visible_upper_rim_z_m"],
   470	            "margin_below_rim_m": (rim["visible_upper_rim_z_m"] - max_z) if max_z is not None else None,
   471	            "inner_radius_m": sector_radius,
   472	            "skin_cut_vertices_outside_inner_radius": int(outside.sum()),
   473	            "max_skin_cut_z_outside_inner_radius_m": outside_max_z,
   474	            "outside_inner_radius_above_rim_violations": sector_violations,
   475	        })
   476	    margin = rim["visible_upper_rim_z_m"] - cut_z
   477	    assert margin >= 0.025 - 1.0e-7
   478	    assert not on_cut.any() or float(points[on_cut, 2].max()) <= rim["visible_upper_rim_z_m"] - 0.025 + 1.0e-7
   479	    return {
   480	        "candidate": str(CANDIDATE.relative_to(ROOT)),
   481	        "source_body_read_only": str(BASE.relative_to(ROOT)),
   482	        "source_meshy_read_only": str(MESHY.relative_to(ROOT)),
   483	        "rim_measurement": rim,
   484	        "cut_plane_z_m": cut_z,
   485	        "cut_plane_margin_below_visible_rim_m": margin,
   486	        "minimum_required_margin_m": 0.025,
   487	        "planar_cut_pass": margin >= 0.025,
   488	        "cap": cut_stats,
   489	        "classification": classification,
   490	        "skin_cut_boundary_by_angular_sector": rows,
   491	        "skin_cut_boundary_vertices_above_rim_minus_25mm": int(np.sum(on_cut & (points[:, 2] > rim["visible_upper_rim_z_m"] - 0.025 + 1.0e-7))),
   492	        "skin_cut_boundary_outside_inner_radius_above_rim_violations": outside_above_rim,
   493	        "floating_hair_component_rule": {"entire_bbox_below_cut": True, "max_bbox_dimension_m": FLOATING_FRAGMENT_MAX_M},
   494	        "floating_hair_components_removed": len(floating_records),
   495	        "floating_hair_components": floating_records,
   496	        "hair_vertex_count_after": int(np.sum(vertex_hair >= 0.5)),
   497	        "skin_vertex_count_after": int(np.sum(vertex_skin >= 0.5)),
   498	        "gorget_shards": gorget_shards(),
   499	    }
