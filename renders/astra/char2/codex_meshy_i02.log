     1	"""Build Meshy graft iteration 02: geometry and material only, never render.
     2	
     3	The protected inputs are opened read-only and the result is written to the
     4	iteration-02 candidate path.  The Meshy source is rebuilt from the original GLB
     5	so the iteration-01 texture trim cannot carry shredded hair into this pass.
     6	"""
     7	import bpy
     8	import bmesh
     9	import json
    10	import math
    11	import numpy as np
    12	from pathlib import Path
    13	
    14	
    15	ROOT = Path(__file__).resolve().parents[1]
    16	OUT = ROOT / "renders/astra/char2"
    17	BASE = ROOT / "models/astra_character_v2_pre_likeness.blend"
    18	MESHY = ROOT / "models/meshy_head_approved.glb"
    19	CANDIDATE = ROOT / "models/astra_character_v2_meshy_i02.blend"
    20	
    21	SCALE = 0.31
    22	FIT_XY = 1.05
    23	OFFSET = np.array((0.00043, -0.25190, 2.85520), dtype=float)
    24	EYE_PIVOT = np.array((0.00043, -0.37956585, 2.97655010), dtype=float)
    25	NECK_BASE_Z = 2.605
    26	RIM_CLEARANCE_M = 0.040
    27	FLOATING_FRAGMENT_MAX_M = 0.015
    28	SECTORS = 24
    29	
    30	# The source texture is sRGB-like packed GLB data (quantized to 8-bit values).
    31	# A face is hair when it is both darker/warmer than skin and geometrically
    32	# outside the central facial/neck core.  Thresholds are deliberately explicit
    33	# and are serialized to the audit JSON.
    34	HAIR_LUMA_MAX = 0.665
    35	HAIR_STRONG_LUMA_MAX = 0.595
    36	HAIR_R_MINUS_B_MIN = 0.175
    37	HAIR_G_MINUS_B_MIN = 0.085
    38	
    39	# Skin correction requested by SPEC.  Hue 0.5 is neutral in Blender; 0.485 is
    40	# a small shift toward orange/red.  The base color is multiplied by SPEC skin,
    41	# then receives +15% saturation and -8% value, and is mixed through the same
    42	# geometry/texel classification mask.  Hair remains the untouched input color.
    43	SPEC_SKIN = (0.95, 0.90, 0.82, 1.0)
    44	SKIN_HUE = 0.485
    45	SKIN_SATURATION = 1.15
    46	SKIN_VALUE = 0.92
    47	
    48	
    49	def reset_pose(arm):
    50	    for bone in arm.pose.bones:
    51	        bone.matrix_basis.identity()
    52	    bpy.context.view_layer.update()
    53	
    54	
    55	def world_points(ob):
    56	    return np.array([ob.matrix_world @ v.co for v in ob.data.vertices], dtype=float)
    57	
    58	
    59	def base_color_pixels(mat):
    60	    for node in mat.node_tree.nodes:
    61	        if node.type != "TEX_IMAGE" or not node.image:
    62	            continue
    63	        if any(link.to_socket.name == "Base Color" for link in node.outputs["Color"].links):
    64	            image = node.image
    65	            width, height = image.size
    66	            pixels = np.asarray(image.pixels[:], dtype=np.float32).reshape(height, width, 4)
    67	            return node, image, pixels, width, height
    68	    raise RuntimeError("Meshy material has no image feeding Principled Base Color")
    69	
    70	
    71	def face_rgb(ob, pixels, width, height):
    72	    uv = ob.data.uv_layers.active
    73	    if uv is None:
    74	        raise RuntimeError("Meshy mesh has no active UV layer")
    75	    values = np.zeros((len(ob.data.polygons), 3), dtype=np.float32)
    76	    for poly in ob.data.polygons:
    77	        samples = []
    78	        for loop_index in poly.loop_indices:
    79	            u, v = uv.data[loop_index].uv
    80	            x = min(width - 1, max(0, int(float(u) * (width - 1))))
    81	            y = min(height - 1, max(0, int(float(v) * (height - 1))))
    82	            samples.append(pixels[y, x, :3])
    83	        values[poly.index] = np.mean(samples, axis=0)
    84	    return values
    85	
    86	
    87	def classify_faces(ob, rgb):
    88	    points = np.array([v.co[:] for v in ob.data.vertices], dtype=float)
    89	    hair = np.zeros(len(ob.data.polygons), dtype=bool)
    90	    skin = np.zeros(len(ob.data.polygons), dtype=bool)
    91	    lumas = np.zeros(len(ob.data.polygons), dtype=np.float32)
    92	    centers_raw = np.zeros((len(ob.data.polygons), 3), dtype=np.float32)
    93	    for poly in ob.data.polygons:
    94	        center_world = points[list(poly.vertices)].mean(axis=0)
    95	        # Reproduce and invert i01's exact placement order: scale was applied
    96	        # to local coordinates, XY was fitted around EYE_PIVOT in local space,
    97	        # and OFFSET remained as object translation until baked below.
    98	        prefit_local = center_world - OFFSET
    99	        prefit_local[:2] = EYE_PIVOT[:2] + (prefit_local[:2] - EYE_PIVOT[:2]) / FIT_XY
   100	        raw = prefit_local / SCALE
   101	        centers_raw[poly.index] = raw
   102	        color = rgb[poly.index]
   103	        luma = float(color @ np.array((0.2126, 0.7152, 0.0722)))
   104	        lumas[poly.index] = luma
   105	        warm = float(color[0] - color[2]) >= HAIR_R_MINUS_B_MIN and float(color[1] - color[2]) >= HAIR_G_MINUS_B_MIN
   106	        face_core = abs(raw[0]) < 0.305 and raw[1] < -0.205 and -0.18 < raw[2] < 0.54
   107	        neck_core = abs(raw[0]) < 0.235 and raw[1] < 0.10 and -0.60 < raw[2] <= -0.18
   108	        hair_geometry = (
   109	            raw[2] > 0.54 or abs(raw[0]) > 0.305 or raw[1] > -0.080
   110	            or (raw[2] < -0.18 and (abs(raw[0]) > 0.205 or raw[1] > 0.015))
   111	        )
   112	        strong_color = luma <= HAIR_STRONG_LUMA_MAX and warm
   113	        ordinary_color = luma <= HAIR_LUMA_MAX and warm
   114	        is_hair = hair_geometry and ordinary_color and not (face_core or neck_core)
   115	        # Strong dark/warm texels capture narrow fringe and braid faces just
   116	        # inside the broader geometry envelope, but never the central face.
   117	        if strong_color and not face_core and not neck_core:
   118	            is_hair = True
   119	        hair[poly.index] = is_hair
   120	
   121	        skin_geometry = face_core or neck_core or (
   122	            abs(raw[0]) < 0.39 and raw[1] < 0.10 and -0.60 < raw[2] < 0.72
   123	        )
   124	        skin_color = luma >= 0.43 and float(color[0] - color[2]) >= 0.105
   125	        skin[poly.index] = (not is_hair) and skin_geometry and skin_color
   126	    return hair, skin, lumas, centers_raw
   127	
   128	
   129	def add_face_masks(ob, hair_faces, skin_faces):
   130	    for name in ("meshy_hair_mask", "meshy_skin_mask"):
   131	        old = ob.data.color_attributes.get(name)
   132	        if old:
   133	            ob.data.color_attributes.remove(old)
   134	    hair_attr = ob.data.color_attributes.new(name="meshy_hair_mask", type="FLOAT_COLOR", domain="CORNER")
   135	    skin_attr = ob.data.color_attributes.new(name="meshy_skin_mask", type="FLOAT_COLOR", domain="CORNER")
   136	    for poly in ob.data.polygons:
   137	        hv = 1.0 if hair_faces[poly.index] else 0.0
   138	        sv = 1.0 if skin_faces[poly.index] else 0.0
   139	        for li in poly.loop_indices:
   140	            hair_attr.data[li].color = (hv, hv, hv, 1.0)
   141	            skin_attr.data[li].color = (sv, sv, sv, 1.0)
   142	
   143	
   144	def split_hair(ob, hair_faces):
   145	    before = set(bpy.data.objects)
   146	    bpy.context.view_layer.objects.active = ob
   147	    ob.select_set(True)
   148	    for poly in ob.data.polygons:
   149	        poly.select = bool(hair_faces[poly.index])
   150	    bpy.ops.object.mode_set(mode="EDIT")
   151	    bpy.ops.mesh.separate(type="SELECTED")
   152	    bpy.ops.object.mode_set(mode="OBJECT")
   153	    created = [x for x in bpy.data.objects if x not in before and x.type == "MESH"]
   154	    if len(created) != 1:
   155	        raise RuntimeError(f"Expected one separated hair object, found {[x.name for x in created]}")
   156	    hair = created[0]
   157	    hair.name = "AstraChar2_Meshy_Hair_i02_work"
   158	    ob.name = "AstraChar2_Meshy_Skin_i02_work"
   159	    return hair
