    71	def face_rgb(ob, pixels, width, height):
    72	    uv = ob.data.uv_layers.active
    73	    if uv is None:
    74	        raise RuntimeError("Meshy mesh has no active UV layer")
    75	    values = np.zeros((len(ob.data.polygons), 3), dtype=np.float32)
    76	    for poly in ob.data.polygons:
