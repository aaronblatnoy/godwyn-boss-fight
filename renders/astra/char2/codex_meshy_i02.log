+    return {"skin_faces": skin_faces, "other_faces": len(ob.data.polygons) - skin_faces,
+            "skin_image": skin_image.name, "hair_image": source_image.name,
+            "hair_material": hair_mat.name, "skin_material": skin_mat.name}
