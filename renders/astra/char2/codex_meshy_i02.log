   266	def install_skin_nodes(mat):
   267	    mat.name = "AstraChar2 Meshy i02 PBR head+hair warm skin mask"
   268	    nodes = mat.node_tree.nodes
   269	    links = mat.node_tree.links
   270	    image_node, image, _, _, _ = base_color_pixels(mat)
   271	    bsdf = next((n for n in nodes if n.type == "BSDF_PRINCIPLED"), None)
   272	    if bsdf is None:
   273	        raise RuntimeError("Meshy material has no Principled BSDF")
   274	    for name in ("Meshy i02 SPEC multiply", "Meshy i02 warm HSV", "Meshy i02 skin mask", "Meshy i02 skin mix"):
   275	        old = nodes.get(name)
   276	        if old:
   277	            nodes.remove(old)
   278	
   279	    multiply = nodes.new("ShaderNodeMixRGB")
   280	    multiply.name = multiply.label = "Meshy i02 SPEC multiply"
   281	    multiply.blend_type = "MULTIPLY"
   282	    multiply.inputs[0].default_value = 1.0
   283	    multiply.inputs[2].default_value = SPEC_SKIN
   284	
   285	    hsv = nodes.new("ShaderNodeHueSaturation")
   286	    hsv.name = hsv.label = "Meshy i02 warm HSV"
   287	    hsv.inputs[0].default_value = SKIN_HUE
   288	    hsv.inputs[1].default_value = SKIN_SATURATION
   289	    hsv.inputs[2].default_value = SKIN_VALUE
   290	    hsv.inputs[3].default_value = 1.0
   291	
   292	    attr = nodes.new("ShaderNodeAttribute")
   293	    attr.name = attr.label = "Meshy i02 skin mask"
   294	    attr.attribute_name = "meshy_skin_mask"
   295	
   296	    mix = nodes.new("ShaderNodeMixRGB")
   297	    mix.name = mix.label = "Meshy i02 skin mix"
   298	    mix.blend_type = "MIX"
   299	
   300	    links.new(image_node.outputs["Color"], multiply.inputs[1])
   301	    links.new(multiply.outputs["Color"], hsv.inputs[4])
   302	    links.new(image_node.outputs["Color"], mix.inputs[1])
   303	    links.new(hsv.outputs[0], mix.inputs[2])
   304	    links.new(attr.outputs["Fac"], mix.inputs[0])
   305	    for link in list(bsdf.inputs["Base Color"].links):
   306	        links.remove(link)
   307	    links.new(mix.outputs["Color"], bsdf.inputs["Base Color"])
   308	    return image.name
