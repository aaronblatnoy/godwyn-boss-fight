   275	def rising_spin_validation():
   276	    animation = ROOT / "models/astra_move_rising_spin_v2_wip.blend"
   277	    bpy.ops.wm.open_mainfile(filepath=str(CANDIDATE))
   278	    character_scene = bpy.context.scene
   279	    objects = [ob for ob in character_scene.objects if ob.type not in {"LIGHT", "CAMERA"} and ob.name != "Astra evaluation ground"]
   280	    rig = bpy.data.objects["Armature"]
   281	    hair_flags = face_hair_flags(bpy.data.objects["AstraChar2_Meshy_HeadHair"])
   282	    with bpy.data.libraries.load(str(animation), link=False) as (source, target):
   283	        target.scenes = source.scenes[:]
   284	    scene = target.scenes[0]
   285	    bpy.context.window.scene = scene
   286	    old_rig = next(ob for ob in scene.objects if ob.type == "ARMATURE")
   287	    old_assets = [ob for ob in list(scene.objects) if ob.type not in {"CAMERA", "LIGHT"} and ob.name != "Astra evaluation ground"]
   288	    action = old_rig.animation_data.action
   289	    rest_error = max(abs(old_rig.data.bones[name].matrix_local[i][j] - rig.data.bones[name].matrix_local[i][j])
   290	                     for name in old_rig.pose.bones.keys() for i in range(4) for j in range(4))
   291	    assert rest_error == 0.0
   292	    for ob in objects:
   293	        scene.collection.objects.link(ob)
   294	    rig.animation_data_create()
   295	    transferred = action.copy()
   296	    transferred.name = action.name + "_MeshyI02Proof"
   297	    rig.animation_data.action = transferred
   298	    if transferred.slots:
   299	        rig.animation_data.action_slot = transferred.slots[0]
   300	    for ob in old_assets:
   301	        bpy.data.objects.remove(ob, do_unlink=True)
   302	    bpy.data.scenes.remove(character_scene)
   303	    scene.frame_set(40)
   304	    bpy.context.view_layer.update()
   305	
   306	    head = scene.objects["AstraChar2_Meshy_HeadHair"]
   307	    sword = scene.objects["Godwyn_Sword"]
   308	    coords, faces = evaluated(head)
   309	    assert len(faces) == len(hair_flags)
   310	    head_faces = [face for face, is_hair in zip(faces, hair_flags) if not is_hair]
   311	    hair_faces = [face for face, is_hair in zip(faces, hair_flags) if is_hair]
   312	    neck = scene.objects["AstraChar2_Meshy_NeckBlend"]
   313	    neck_coords, neck_faces = evaluated(neck)
   314	    offset = len(coords)
   315	    head_coords = np.vstack((coords, neck_coords))
   316	    head_faces.extend(tuple(offset + index for index in face) for face in neck_faces)
   317	    head_bvh = BVHTree.FromPolygons(head_coords.tolist(), head_faces)
   318	    hair_bvh = BVHTree.FromPolygons(coords.tolist(), hair_faces)
   319	
   320	    source_attr = np.array([entry.vector[:] for entry in sword.data.attributes["astra_sword_source"].data])
   321	    sword_coords, sword_faces = evaluated(sword)
   322	    blade_ids = set(int(index) for index in np.where(source_attr[:, 2] < 150)[0])
   323	    blade_faces = [face for face in sword_faces if all(index in blade_ids for index in face)]
   324	    blade_bvh = BVHTree.FromPolygons(sword_coords.tolist(), blade_faces)
   325	    head_overlap = head_bvh.overlap(blade_bvh)
   326	    hair_overlap = hair_bvh.overlap(blade_bvh)
   327	    blade_samples = sword_coords[sorted(blade_ids)[::3]]
   328	    head_distance = min(nearest_distance(head_bvh, blade_samples), nearest_distance(blade_bvh, head_coords[::12]))
   329	    hair_distance = min(nearest_distance(hair_bvh, blade_samples), nearest_distance(blade_bvh, coords[::12]))
   330	    if head_overlap:
   331	        head_distance = 0.0
   332	    if hair_overlap:
   333	        hair_distance = 0.0
   334	    report = {
   335	        "animation": str(animation.relative_to(ROOT)),
   336	        "candidate": str(CANDIDATE.relative_to(ROOT)),
   337	        "frame": 40,
   338	        "blade_head_exact_triangle_overlaps": len(head_overlap),
   339	        "blade_hair_exact_triangle_overlaps": len(hair_overlap),
   340	        "blade_head_sampled_surface_distance_m": float(head_distance),
   341	        "blade_hair_sampled_surface_distance_m": float(hair_distance),
   342	        "mesh_partition": "meshy_hair_mask face-corner attribute; complement plus neck band is head/skin/other",
   343	        "head_triangles_or_polygons": len(head_faces),
   344	        "hair_triangles_or_polygons": len(hair_faces),
   345	        "blade_triangles_or_polygons": len(blade_faces),
   346	        "assembly_rest_transform_max_error": rest_error,
   347	        "bones": len(rig.data.bones),
   348	        "numeric_only": True,
   349	        "render_calls": 0,
   350	    }
   351	    assert report["bones"] == 121 and not head_overlap and not hair_overlap
   352	    assert head_distance > 0.0 and hair_distance > 0.0
   353	    RISING.write_text(json.dumps(report, indent=2) + "\n")
   354	    print("MESHY_I02_RISING_PASS", json.dumps(report), flush=True)
