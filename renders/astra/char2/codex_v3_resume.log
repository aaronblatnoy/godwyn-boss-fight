+++ b/scripts/astra_v3_publish.py
@@ -1,8 +1,10 @@
 """Publish Godwyn v3 Blend/GLB and round-trip validate skeleton plus five clips."""
 
+import argparse
 import hashlib
 import json
 import struct
+import sys
 from pathlib import Path
 
 import bpy
@@ -27,9 +29,26 @@
