  ssh black-sky "cd ~/godwyn-boss-fight && blender --background --python-exit-code 1 --python scripts/astra_v3_audit.py -- --blend models/astra_character_v3fists_wip.blend --samples renders/astra/char2/meshy_v3fists_retarget_samples.json --out renders/astra/char2/meshy_v3fists_audit.json --require-pass"
  rc=$?
