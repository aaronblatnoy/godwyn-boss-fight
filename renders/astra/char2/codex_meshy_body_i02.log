+def apply_limb_correction(body, rig):
+    world = rig.matrix_world
+    left_elbow = world @ rig.data.bones["LeftForeArm"].head_local
+    left_hand = world @ rig.data.bones["LeftHand"].head_local
+    left_shoulder = world @ rig.data.bones["LeftArm"].head_local
+    source_shoulder = Vector((-left_shoulder.x, left_shoulder.y, left_shoulder.z))
+    source_elbow = Vector((-left_elbow.x, left_elbow.y, left_elbow.z))
+    source_hand = Vector((-left_hand.x, left_hand.y, left_hand.z))
+    target_hand = world @ rig.data.bones["RightHand"].head_local
+    source_vector = source_hand - source_elbow
+    target_vector = target_hand - source_elbow
+    angle = math.degrees(source_vector.angle(target_vector))
+    report = {"applied": angle > 8.0, "threshold_deg": 8.0,
+              "right_forearm_source_elbow_world_m": list(source_elbow),
+              "right_forearm_source_hand_world_m": list(source_hand),
+              "right_forearm_target_hand_world_m": list(target_hand),
+              "right_forearm_rotation_deg": angle,
+              "selection": "right-side vertices whose nearest one of the 21 body-bone segments is the inferred source RightForeArm/RightHand segment, within 0.24 m"}
+    if angle <= 8.0:
+        report["vertices_rotated"] = 0
+        return report
+    rotation = source_vector.rotation_difference(target_vector)
+    segments = bone_segments(rig)
+    segments["RightArm"] = (source_shoulder, source_elbow)
+    segments["RightForeArm"] = (source_elbow, source_hand)
+    segments["RightHand"] = (source_hand, source_hand)
+    rotated = 0
+    maximum_displacement = 0.0
+    for vertex in body.data.vertices:
+        point = body.matrix_world @ vertex.co
+        if point.x > -0.24 or point.z < 1.35 or point.z > 2.35:
+            continue
+        distances = {name: point_segment_distance(point, start, end)
+                     for name, (start, end) in segments.items()}
+        nearest_name = min(distances, key=distances.get)
+        lower_distance = distances[nearest_name]
+        if nearest_name not in {"RightForeArm", "RightHand"} or lower_distance > 0.24:
+            continue
+        corrected = source_elbow + rotation @ (point - source_elbow)
+        maximum_displacement = max(maximum_displacement, (corrected - point).length)
+        vertex.co = body.matrix_world.inverted() @ corrected
+        rotated += 1
+    body.data.update()
+    report["vertices_rotated"] = rotated
+    report["maximum_vertex_displacement_m"] = maximum_displacement
+    return report
+
