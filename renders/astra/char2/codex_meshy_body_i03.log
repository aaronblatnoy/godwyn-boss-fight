+def point_segment(point, start, end):
+    axis = end - start
+    if axis.length_squared < 1e-12:
+        return (point - start).length, 0.0
+    amount = max(0.0, min(1.0, (point - start).dot(axis) / axis.length_squared))
+    return (point - (start + axis * amount)).length, amount
