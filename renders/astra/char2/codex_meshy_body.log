/bin/zsh -lc "python3 -m py_compile scripts/astra_body_build.py && ruff check scripts/astra_body_build.py && scp scripts/astra_body_build.py black-sky:~/godwyn-boss-fight/scripts/astra_body_build.py && ssh black-sky 'cd ~/godwyn-boss-fight && blender --background --python-exit-code 1 --python scripts/astra_body_build.py' | tee /tmp/astra_body_build_i01b.log" in /Users/aaron_7nh0yzm/godwyn-boss-fight
