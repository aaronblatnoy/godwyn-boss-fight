+
+    report_sections.append(
+        f"""## {name}
+
+Method: {transfer['method']}. The action digest is `{transfer['action_digest']}`; all {transfer['action_fcurves']} F-curves and {transfer['action_keys']} keys transferred without retargeting, with rest-matrix and quarter-frame pose-matrix error both {transfer['rest_matrix_max_error']:.1f}.
+
+| Numeric check | Old body | Published v2 body |
+|---|---:|---:|
+| Numeric leaves in {motion_label} | {motion_inventory['before_numeric_leaves']} | {motion_inventory['after_numeric_leaves']} |
