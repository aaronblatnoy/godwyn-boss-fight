+            "blade_hair": head["blade_hair"],
+            "all_brows_bound_and_weighted": all(
+                x["armature_binding_ok"] and x["unweighted"] == 0 and x["bad_weight_sum"] == 0
+                for x in head["binding"]["brows"].values()
+            ),
