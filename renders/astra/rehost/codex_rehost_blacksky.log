+        }
+        new_motion_compact = {
+            "bone_count": new_motion.get("bone_count"),
+            "curve_count": new_motion.get("curve_count"),
+            "key_count": new_motion.get("key_count"),
+            "max_key_gap": new_motion.get("max_key_gap"),
