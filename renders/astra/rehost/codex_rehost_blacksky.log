+def sha256(path: str | Path) -> str:
+    h = hashlib.sha256()
+    with (ROOT / path).open("rb") as handle:
+        for block in iter(lambda: handle.read(1024 * 1024), b""):
+            h.update(block)
+    return h.hexdigest()
