+    },
+    "moves": {},
+    "audit": "renders/astra/rehost/REHOST_REPORT.md",
+    "protected_inputs_unchanged": True,
+}
+
+report_sections: list[str] = []
+sanity_rows: list[str] = []
+
+for name, job in JOBS.items():
