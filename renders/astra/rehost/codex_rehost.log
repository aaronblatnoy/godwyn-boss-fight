report={'name':name,'hips_yaw_peak_deg_s':a['peak_hips_yaw_deg_s'],'airborne_frames':a['support_summary']['airborne_frames'],'end_root_velocity_m_s':[x*120 for x in sub(rs[-1]['bones']['Hips']['h'],rs[-2]['bones']['Hips']['h'])]}
