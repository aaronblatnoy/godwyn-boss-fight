    w,x,y,z=q;a,b,c,d=p;return [w*a-x*b-y*c-z*d,w*b+x*a+y*d-z*c,w*c-x*d+y*a+z*b,w*d+x*c-y*b+z*a]
def inv(q):return [q[0],-q[1],-q[2],-q[3]]
def rot(q,p):return mul(mul(q,[0]+list(p)),inv(q))[1:]
