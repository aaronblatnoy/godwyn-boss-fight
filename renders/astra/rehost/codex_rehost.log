diff --git a/scripts/astra_xslash_naturalness_probe.py b/scripts/astra_xslash_naturalness_probe.py
index 2063b876bd66035c35cb7a1222da57d482424793..4bdc751afc23440bf473df8aae487ed49cc68bbf
--- a/scripts/astra_xslash_naturalness_probe.py
