 src=np.array([p.vector[:] for p in sw.data.attributes['astra_sword_source'].data]);loc=np.array([v.co[:] for v in sw.data.vertices]);fit=np.linalg.lstsq(np.column_stack((src,np.ones(len(src)))),loc,rcond=None)[0]
