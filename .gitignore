# Runnable workflow specs live in lifecycle/{pending,archive}/workflows/.
# They contain server-specific connection details, so keep them out of the
# public repo (organized on disk, not committed).
lifecycle/pending/workflows/*.js
lifecycle/archive/workflows/*.js
lifecycle/archive/plans/blender-build-plan.txt

# Blender working files
*.blend1
renders/wip/
renders/_discarded/

# Phase 11 production rig is staged only on black-sky. Keep the large binary
# out of Git and out of the Mac game tree; scenes reference this remote asset.
game/assets/godwyn/*.glb

# junk
.DS_Store
**/.DS_Store
scripts/__pycache__/
*.pyc
__pycache__/
